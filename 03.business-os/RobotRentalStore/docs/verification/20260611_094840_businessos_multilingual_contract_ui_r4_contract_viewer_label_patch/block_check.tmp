/* BUSINESSOS_MULTILINGUAL_CONTRACT_VIEWER_LABELS_START */
(function () {
  "use strict";

  var VIEWER_MESSAGES = {
    ja: {
      "viewer.aiworkerTitle": "AI Worker契約閲覧",
      "viewer.applicationTitle": "アプリケーション契約閲覧",
      "viewer.contractList": "契約一覧",
      "viewer.contractDetail": "契約詳細",
      "viewer.applicationContractDetail": "アプリケーション契約詳細",
      "viewer.selectContract": "左の契約一覧から確認したい契約を選択してください。",
      "viewer.statusFilter": "状態で絞り込み",
      "viewer.appFilter": "アプリで絞り込み",
      "viewer.all": "すべて",
      "viewer.reload": "再読み込み",
      "viewer.contract": "契約",
      "viewer.contractInfo": "契約情報",
      "viewer.payment": "決済",
      "viewer.paymentInfo": "決済情報",
      "viewer.entitlement": "権限",
      "viewer.entitlementInfo": "権限情報",
      "viewer.lineItems": "明細",
      "viewer.history": "履歴",
      "viewer.period": "期間",
      "viewer.endSummary": "終了サマリー",
      "viewer.status": "状態",
      "viewer.amount": "金額",
      "viewer.price": "価格",
      "viewer.createdAt": "作成日",
      "viewer.updatedAt": "更新日",
      "viewer.startedAt": "開始日",
      "viewer.endedAt": "終了日",
      "viewer.application": "アプリケーション",
      "viewer.robot": "ロボット",
      "viewer.model": "モデル",
      "viewer.series": "シリーズ",
      "viewer.none": "なし",
      "viewer.loading": "読み込み中です。"
    },
    en: {
      "viewer.aiworkerTitle": "AI Worker Contracts",
      "viewer.applicationTitle": "Application Contracts",
      "viewer.contractList": "Contract list",
      "viewer.contractDetail": "Contract details",
      "viewer.applicationContractDetail": "Application contract details",
      "viewer.selectContract": "Select a contract from the list to view details.",
      "viewer.statusFilter": "Filter by status",
      "viewer.appFilter": "Filter by application",
      "viewer.all": "All",
      "viewer.reload": "Reload",
      "viewer.contract": "Contract",
      "viewer.contractInfo": "Contract information",
      "viewer.payment": "Payment",
      "viewer.paymentInfo": "Payment information",
      "viewer.entitlement": "Entitlement",
      "viewer.entitlementInfo": "Entitlement information",
      "viewer.lineItems": "Line items",
      "viewer.history": "History",
      "viewer.period": "Period",
      "viewer.endSummary": "End summary",
      "viewer.status": "Status",
      "viewer.amount": "Amount",
      "viewer.price": "Price",
      "viewer.createdAt": "Created",
      "viewer.updatedAt": "Updated",
      "viewer.startedAt": "Started",
      "viewer.endedAt": "Ended",
      "viewer.application": "Application",
      "viewer.robot": "Robot",
      "viewer.model": "Model",
      "viewer.series": "Series",
      "viewer.none": "None",
      "viewer.loading": "Loading."
    }
  };

  var EXACT_TEXT_KEYS = {
    "AI Worker契約閲覧": "viewer.aiworkerTitle",
    "アプリケーション契約閲覧": "viewer.applicationTitle",
    "契約一覧": "viewer.contractList",
    "契約詳細": "viewer.contractDetail",
    "アプリケーション契約詳細": "viewer.applicationContractDetail",
    "左の契約一覧から確認したい契約を選択してください。": "viewer.selectContract",
    "状態で絞り込み": "viewer.statusFilter",
    "アプリで絞り込み": "viewer.appFilter",
    "すべて": "viewer.all",
    "再読み込み": "viewer.reload",
    "契約": "viewer.contract",
    "契約情報": "viewer.contractInfo",
    "決済": "viewer.payment",
    "決済情報": "viewer.paymentInfo",
    "権限": "viewer.entitlement",
    "権限情報": "viewer.entitlementInfo",
    "明細": "viewer.lineItems",
    "履歴": "viewer.history",
    "期間": "viewer.period",
    "終了サマリー": "viewer.endSummary",
    "状態": "viewer.status",
    "金額": "viewer.amount",
    "価格": "viewer.price",
    "作成日": "viewer.createdAt",
    "更新日": "viewer.updatedAt",
    "開始日": "viewer.startedAt",
    "終了日": "viewer.endedAt",
    "アプリケーション": "viewer.application",
    "ロボット": "viewer.robot",
    "モデル": "viewer.model",
    "シリーズ": "viewer.series",
    "なし": "viewer.none",
    "読み込み中です。": "viewer.loading"
  };

  var TITLE_KEY = "viewer.applicationTitle";

  function getI18n() {
    return window.BusinessOSI18N || null;
  }

  function mergeMessages() {
    var i18n = getI18n();
    if (!i18n || !i18n.messages) return;

    Object.keys(VIEWER_MESSAGES).forEach(function (lang) {
      i18n.messages[lang] = i18n.messages[lang] || {};
      Object.keys(VIEWER_MESSAGES[lang]).forEach(function (key) {
        i18n.messages[lang][key] = VIEWER_MESSAGES[lang][key];
      });
    });
  }

  function translate(key) {
    var i18n = getI18n();
    if (i18n && typeof i18n.t === "function") return i18n.t(key);
    var lang = (i18n && i18n.language) || "ja";
    return (VIEWER_MESSAGES[lang] && VIEWER_MESSAGES[lang][key]) || VIEWER_MESSAGES.ja[key] || key;
  }

  function replaceExactTextNode(node) {
    var value = node.nodeValue || "";
    var trimmed = value.trim();
    var key = EXACT_TEXT_KEYS[trimmed];
    if (!key) return;

    var before = value.match(/^\s*/)[0] || "";
    var after = value.match(/\s*$/)[0] || "";
    node.nodeValue = before + translate(key) + after;
  }

  function replaceElementValue(el) {
    if ("value" in el) {
      var value = String(el.value || "").trim();
      var key = EXACT_TEXT_KEYS[value];
      if (key) el.value = translate(key);
    }

    ["title", "placeholder", "aria-label"].forEach(function (attr) {
      var attrValue = String(el.getAttribute(attr) || "").trim();
      var attrKey = EXACT_TEXT_KEYS[attrValue];
      if (attrKey) el.setAttribute(attr, translate(attrKey));
    });
  }

  function applyViewerLabels(root) {
    mergeMessages();

    var base = root || document;
    document.title = translate(TITLE_KEY);

    var walker = document.createTreeWalker(base, NodeFilter.SHOW_TEXT, {
      acceptNode: function (node) {
        var parent = node.parentElement;
        if (!parent) return NodeFilter.FILTER_REJECT;
        var tag = parent.tagName ? parent.tagName.toLowerCase() : "";
        if (tag === "script" || tag === "style") return NodeFilter.FILTER_REJECT;
        if (!String(node.nodeValue || "").trim()) return NodeFilter.FILTER_REJECT;
        return NodeFilter.FILTER_ACCEPT;
      }
    });

    var nodes = [];
    while (walker.nextNode()) nodes.push(walker.currentNode);
    nodes.forEach(replaceExactTextNode);

    base.querySelectorAll("input, button, textarea, select, option, [title], [placeholder], [aria-label]").forEach(replaceElementValue);
  }

  var observerScheduled = false;
  function scheduleApply() {
    if (observerScheduled) return;
    observerScheduled = true;
    window.setTimeout(function () {
      observerScheduled = false;
      applyViewerLabels(document);
    }, 0);
  }

  function run() {
    applyViewerLabels(document);

    var target = document.body || document.documentElement;
    if (target && window.MutationObserver) {
      var observer = new MutationObserver(scheduleApply);
      observer.observe(target, { childList: true, subtree: true, characterData: true });
    }
  }

  window.BusinessOSContractViewerI18N = {
    messages: VIEWER_MESSAGES,
    exactTextKeys: EXACT_TEXT_KEYS,
    apply: applyViewerLabels
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", run);
  } else {
    run();
  }
}());
/* BUSINESSOS_MULTILINGUAL_CONTRACT_VIEWER_LABELS_END */
